---
// Raised, full-bleed workshop photograph between the header and the story.
import { Image } from 'astro:assets';
import { getPhotos } from '../../data/photo-library.js';

// The first kitchen photo (see photo-meta.js `order` to pin a specific one
// once real photos are curated — see that file's top-of-file note).
const photo = getPhotos('kitchens')[0];
---

<section class="raised-panel about-photo">
  {photo && <Image src={photo.image} alt={photo.alt} width={1800} format="webp" quality={82} class="about-photo__img" />}
</section>

<style>
  .about-photo {
    height: min(60vh, 520px);
  }
  .about-photo :global(.about-photo__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
