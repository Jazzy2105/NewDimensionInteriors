---
// Two-column flat section: narrative copy left, a label/value spec list
// right (Established, Where we work, etc).
import { siteConfig } from '../../data/site-config.js';

const specs = [
  { label: 'Established', value: siteConfig.established },
  { label: 'Where we work', value: 'Gauteng & surrounds' },
  { label: 'What we make', value: 'Kitchens · Vanities · BICs' },
  { label: 'Guarantee', value: 'Workmanship warranted' },
  { label: 'Quotation', value: 'Free, on site' },
];
---

<section class="flat-section story">
  <div class="story__copy">
    <h2 class="story__heading">
      <span class="story__heading-name">New Dimension Interiors</span>
      <span>Exceptional Design. Bespoke Craftsmanship. Inspired Living.</span>
    </h2>
    <p class="story__body">
      New Dimension Interiors (NDI) is a proudly South African, privately owned interior design and custom joinery
      company established in 2002. From our beginnings as a small business, we have evolved into a trusted name in
      the middle to upmarket home improvement sector, delivering distinctive design, superior craftsmanship and
      exceptional service.
    </p>
    <p class="story__body">
      Based in the south of Johannesburg, NDI has established a strong reputation for creating and installing
      bespoke interiors in some of Gauteng’s most prestigious estates and neighbourhoods.
    </p>
  </div>
  <dl class="story__specs">
    {
      specs.map((spec) => (
        <div class="story__spec-row">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }

  .story__copy {
    padding: clamp(32px, 5vw, 72px) var(--section-pad-x);
    border-right: 2px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Below this, the two auto-fit columns above have already wrapped to one
     (2 × the 320px minimum), so a right-hand divider would just dangle
     under the copy with nothing beside it — a bottom divider instead. */
  @media (max-width: 639px) {
    .story__copy {
      border-right: 0;
      border-bottom: 2px solid var(--color-divider);
    }
  }

  .story__heading {
    /* Two lines in the supplied copy — the company name over its tagline —
       so they are spans in a column rather than one wrapped run. */
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .story__heading-name {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .story__body {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-neutral-700);
  }

  .story__specs {
    margin: 0;
    padding: clamp(32px, 5vw, 72px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
  }

  .story__spec-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 2px solid var(--color-divider);
  }
  .story__spec-row:last-child {
    border-bottom: 0;
  }

  .story__spec-row dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }

  .story__spec-row dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 17px;
  }
</style>
