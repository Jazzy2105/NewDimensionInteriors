---
// About preview — raised panel, copy left, one fixed photo right. The photo
// is pinned to src/assets/images/about us/AboutUsMain.png (see the README
// there) rather than drawn from the gallery library, so it never changes
// when gallery photos are added or reordered.
import { Image } from 'astro:assets';
import aboutPhoto from '../../assets/images/about us/AboutUsMain.png';
import { withBase } from '../../lib/url.js';
import IconArrowRight from '../icons/IconArrowRight.astro';

---

<section id="about" class="raised-panel about-preview">
  <div class="about-preview__copy">
    <span class="kicker">About N.D.I.</span>
    <h2 class="about-preview__heading">
      <span>A True Story To Tell ---</span>
      <span>A family workshop, not a trending showroom chain…</span>
    </h2>
    <p class="about-preview__body">
      New Dimension Interiors (Pty) Ltd is not a franchise, it is rather a family affair since its inception back in
      2002. We pride ourselves on the personal touch in which project control and management is directly under the
      supervision of the owners. We do not outsource our installation. Hence our attention to client needs and
      satisfaction is uppermost. Our fundamental belief lies in the fact that clients are our salespeople and their
      homes are our showroom. Over the years, we’ve become a trusted name in the industry, thanks to our commitment
      to excellence and innovative approach to cabinetry design.
    </p>
    <a href={withBase('/about')} class="arrow-link">
      More about us
      <IconArrowRight />
    </a>
  </div>
  <div class="about-preview__photo">
    <Image
      src={aboutPhoto}
      alt="A kitchen fitted by N.D.I."
      width={900}
      format="webp"
      loading="lazy"
      class="about-preview__img"
    />
  </div>
</section>

<style>
  .about-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }

  .about-preview__copy {
    padding: clamp(40px, 6vw, 88px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-right: 2px solid var(--color-divider);
  }

  /* See AboutStory.astro's identical comment — once the two auto-fit
     columns wrap to one, a bottom divider reads correctly, a right one
     wouldn't. */
  @media (max-width: 639px) {
    .about-preview__copy {
      border-right: 0;
      border-bottom: 2px solid var(--color-divider);
    }
  }

  .about-preview__heading {
    /* Two statements with a blank line between them in the supplied copy, so
       the lines are spans in a column rather than one wrapped run. */
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-size: clamp(30px, 3.8vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .about-preview__body {
    margin: 0;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-neutral-700);
  }

  .about-preview__photo {
    position: relative;
    min-height: 320px;
    overflow: hidden;
  }

  .about-preview__photo :global(.about-preview__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
