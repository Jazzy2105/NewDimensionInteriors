---
// Contact details plus a WhatsApp call-to-action. The design handoff's
// quote-request form was removed: the site is static hosting with no mail
// endpoint, so enquiries go through phone, email or WhatsApp instead.
import { siteConfig, waHref } from '../../data/site-config.js';
import IconWhatsApp from '../icons/IconWhatsApp.astro';
import IconPdf from '../icons/IconPdf.astro';
import { withBase } from '../../lib/url.js';

const termsHref = withBase(siteConfig.termsPdfPath);
---

<section id="contact" class="raised-panel contact">
  <span class="kicker">Get a quote</span>
  <h2 class="contact__heading">Get in Touch</h2>
  <div class="contact__details">
    <a href={siteConfig.phoneHref} class="contact__detail">
      <span class="contact__detail-label">Phone</span>
      <span>{siteConfig.phoneDisplay}</span>
    </a>
    <a href={`mailto:${siteConfig.email}`} class="contact__detail">
      <span class="contact__detail-label">Email</span>
      <span>{siteConfig.email}</span>
    </a>
    <div class="contact__detail contact__detail--static">
      <span class="contact__detail-label">Workshop</span>
      <span>{siteConfig.workshopLocation}</span>
    </div>
  </div>
  <a href={waHref()} target="_blank" rel="noopener" class="btn btn-accent contact__whatsapp">
    <IconWhatsApp size={18} />
    <span>WhatsApp us</span>
  </a>

  <div id="terms" class="contact__terms">
    <IconPdf size={44} />
    <div class="contact__terms-text">
      <span class="contact__detail-label">Terms &amp; Conditions</span>
      <span class="contact__terms-name">NDI Terms and Conditions 2025 &middot; PDF</span>
    </div>
    <div class="contact__terms-actions">
      <a href={termsHref} target="_blank" rel="noopener" class="btn btn-ghost">View</a>
      <a href={termsHref} download={siteConfig.termsPdfFilename} class="btn btn-white">Download PDF</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: clamp(40px, 6vw, 80px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact__heading {
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    border-top: 2px solid var(--color-divider);
    padding-top: 16px;
  }

  .contact__detail {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-neutral-300);
    font-size: 15px;
    transition: color 200ms ease;
  }
  .contact__detail:hover {
    color: var(--color-accent-400);
  }
  .contact__detail--static {
    border-bottom: 0;
  }

  .contact__detail-label {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--color-neutral-600);
  }

  .contact__whatsapp {
    align-self: flex-start;
    margin-top: 8px;
  }

  .contact__terms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
    margin-top: 16px;
    padding: 18px 20px;
    border: 1px solid var(--color-panel-border);
    border-radius: 4px;
    background: var(--color-tile-bg);
    color: var(--color-neutral-700);
    scroll-margin-top: 120px;
  }

  .contact__terms-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 200px;
  }

  .contact__terms-name {
    font-size: 15px;
    color: var(--color-text);
  }

  .contact__terms-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
