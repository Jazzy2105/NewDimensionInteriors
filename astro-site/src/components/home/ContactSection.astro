---
// Contact details plus a WhatsApp call-to-action. The design handoff's
// quote-request form was removed: the site is static hosting with no mail
// endpoint, so enquiries go through phone, email or WhatsApp instead.
import { siteConfig, waHref } from '../../data/site-config.js';
import IconWhatsApp from '../icons/IconWhatsApp.astro';
---

<section id="contact" class="raised-panel contact">
  <span class="kicker">Get a quote</span>
  <h2 class="contact__heading">Get in Touch</h2>
  <div class="contact__details">
    <a href={siteConfig.phoneHref} class="contact__detail">
      <span class="contact__detail-label">Phone</span>
      <span>{siteConfig.phoneDisplay}</span>
    </a>
    <a href={`mailto:${siteConfig.email}`} class="contact__detail">
      <span class="contact__detail-label">Email</span>
      <span>{siteConfig.email}</span>
    </a>
    <div class="contact__detail contact__detail--static">
      <span class="contact__detail-label">Workshop</span>
      <span>{siteConfig.workshopLocation}</span>
    </div>
  </div>
  <a href={waHref()} target="_blank" rel="noopener" class="btn btn-accent contact__whatsapp">
    <IconWhatsApp size={18} />
    <span>WhatsApp us</span>
  </a>
</section>

<style>
  .contact {
    padding: clamp(40px, 6vw, 80px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact__heading {
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    border-top: 2px solid var(--color-divider);
    padding-top: 16px;
  }

  .contact__detail {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-neutral-300);
    font-size: 15px;
    transition: color 200ms ease;
  }
  .contact__detail:hover {
    color: var(--color-accent-400);
  }
  .contact__detail--static {
    border-bottom: 0;
  }

  .contact__detail-label {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--color-neutral-600);
  }

  .contact__whatsapp {
    align-self: flex-start;
    margin-top: 8px;
  }
</style>
