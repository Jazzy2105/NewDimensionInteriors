---
// "04 — Home decor" — flat, image-left / text-right, same layout as
// CupboardsSection. Shows a real photo once one exists — see that file.
import { Image } from 'astro:assets';
import { getFeatured } from '../../data/photo-library.js';
import IconArrowRight from '../icons/IconArrowRight.astro';
import PlaceholderPhoto from '../ui/PlaceholderPhoto.astro';

const photo = getFeatured('decor', 1)[0];
---

<section id="decor" class="flat-section split">
  <div class="split__media">
    {
      photo ? (
        <Image src={photo.image} alt={photo.alt} width={1200} format="webp" loading="lazy" class="split__img" />
      ) : (
        <PlaceholderPhoto brief="Drop a home decor / joinery photo" />
      )
    }
  </div>
  <div class="split__copy">
    <span class="kicker">04 — Home decor</span>
    <h2 class="split__heading">The pieces that finish the room.</h2>
    <p class="split__body">
      Wall units, floating shelves, TV and fireplace surrounds, bars, study desks and headboards — made in the same
      timbers and finishes as the rest of the house so nothing looks bought in.
    </p>
    <a href="/projects" class="arrow-link">
      See home decor
      <IconArrowRight />
    </a>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  }

  .split__media {
    position: relative;
    min-height: min(70vh, 560px);
  }
  .split__media :global(.split__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__copy {
    padding: clamp(32px, 5vw, 80px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
    border-left: 2px solid var(--color-divider);
  }

  .split__heading {
    font-size: clamp(30px, 3.8vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .split__body {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
</style>
