---
// "01 — Kitchens" — raised, text-left / image-right. Same split layout as
// VanitiesSection, so all four category sections now share one pattern.
// Which photo shows here is controlled by `featured` in
// src/data/photo-meta.js.
import { Image } from 'astro:assets';
import { getFeatured } from '../../data/photo-library.js';
import { withBase } from '../../lib/url.js';
import IconArrowRight from '../icons/IconArrowRight.astro';
import PlaceholderPhoto from '../ui/PlaceholderPhoto.astro';

const photo = getFeatured('kitchens', 1)[0];
---

<section id="kitchens" class="raised-panel split split--mirrored">
  <div class="split__copy">
    <span class="kicker">01 — Kitchens</span>
    <h2 class="split__heading">Every home is designed around one kitchen.</h2>
    <p class="split__body">
      New Dimension Interiors offers a comprehensive spectrum of quality kitchen finishes and accessories. Our
      installations range from standard economical melamines through to veneers, solid woods and the highest
      quality imported materials, fittings and accessories, in accordance with your budget. We also offer an
      extensive range of kitchen work tops (wood, granite, Quartz stone, Dekton, Stainless Steel and more).
    </p>
    <a href={withBase('/projects')} class="arrow-link">
      View the kitchen gallery
      <IconArrowRight />
    </a>
  </div>
  <div class="split__media">
    {
      photo ? (
        <Image src={photo.image} alt={photo.alt} width={1200} format="webp" loading="lazy" class="split__img" />
      ) : (
        <PlaceholderPhoto brief="Drop a kitchen photo" />
      )
    }
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
  }

  .split--mirrored .split__copy {
    border-right: 2px solid var(--color-divider);
  }

  /* Copy comes first in the DOM (text-left/image-right on desktop), so once
     the columns wrap to one it sits above the photo — a bottom divider
     reads correctly there, a right one wouldn't. */
  @media (max-width: 679px) {
    .split--mirrored .split__copy {
      border-right: 0;
      border-bottom: 2px solid var(--color-divider);
    }
  }

  .split__media {
    position: relative;
    min-height: min(70vh, 560px);
  }
  .split__media :global(.split__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__copy {
    padding: clamp(32px, 5vw, 80px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .split__heading {
    font-size: clamp(30px, 3.8vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .split__body {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
</style>
