---
// "How it works" — four numbered steps, flat section.
const steps = [
  {
    n: '01',
    title: 'Initial Engagement and Site Audit',
    body: 'We come to you. Measure the room, discuss ideas and talk you through the practical process.',
  },
  {
    n: '02',
    title: 'Requirements Definition',
    body: 'We provide a set of 3D renders, samples and finishes at the next meeting together with our comprehensive professional proposal.',
  },
  {
    n: '03',
    title: 'Manufacture',
    body: 'Cut, edged and assembled in our workshop, so tolerances stay ours to fix.',
  },
  {
    n: '04',
    title: 'Installation',
    body: 'Our teams deliver & install while our qualified project managers run the show! Your handover will never be this easy.',
  },
];
---

<section class="flat-section process">
  <div class="process__header">
    <span class="kicker">How it works</span>
    <h2 class="process__heading">Four Steps | One Point of Contact</h2>
  </div>
  <div class="process__grid">
    {
      steps.map((step) => (
        <div class="process__cell">
          <span class="process__number">{step.n}</span>
          <h3 class="process__title">{step.title}</h3>
          <p class="process__body">{step.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .process__header {
    padding: clamp(40px, 6vw, 80px) var(--section-pad-x) clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .process__heading {
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Same fixed-4-cell divider approach as StatsSection.astro — see its
     comment for why this is keyed to explicit positions instead of
     auto-fit + :last-child. */
  .process__grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 2px solid var(--color-text);
  }

  .process__cell {
    padding: clamp(24px, 3vw, 36px);
    /* Subgrid so number / title / body line up across the cells in a row.
       The title row is exactly as tall as the tallest title in that row
       needs — bodies stay in line when one title wraps, without leaving
       dead space under the titles when none of them do. */
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    gap: 12px;
  }
  .process__cell:nth-child(1),
  .process__cell:nth-child(2),
  .process__cell:nth-child(3) {
    border-bottom: 2px solid var(--color-divider);
  }

  @media (min-width: 560px) {
    .process__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .process__cell:nth-child(1) {
      border-right: 2px solid var(--color-divider);
    }
    .process__cell:nth-child(3) {
      border-right: 2px solid var(--color-divider);
      border-bottom: 0;
    }
  }

  @media (min-width: 900px) {
    .process__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .process__cell:nth-child(1),
    .process__cell:nth-child(2),
    .process__cell:nth-child(3) {
      border-right: 2px solid var(--color-divider);
      border-bottom: 0;
    }
  }

  .process__number {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 14px;
    color: var(--color-accent);
  }

  .process__title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .process__body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
</style>
