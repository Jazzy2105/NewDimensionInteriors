---
// Flat stats strip directly under the hero.
import { siteConfig } from '../../data/site-config.js';

const stats = [
  { value: siteConfig.yearsAtBench, suffix: '+', label: 'Years of solid experience' },
  { value: 'One', suffix: '', label: 'Workshop, start to finish' },
  { value: siteConfig.clientsServed, suffix: '+', label: 'Happy and satisfied customers' },
  // "Complimentary" is a whole word where the other three values are a
  // number or something short — `long` drops it to its own, smaller type
  // scale so it still fits the cell at the 4-across breakpoint.
  { value: 'Complimentary', suffix: '', label: 'Consultation and proposal', long: true },
];
---

<section class="flat-section stats" aria-label="N.D.I. in numbers">
  <div class="stats__grid">
    {
      stats.map((stat) => (
        <div class="stats__cell">
          <span class={`stats__value ${stat.long ? 'is-long' : ''}`}>
            {stat.value}
            {stat.suffix && <span class="stats__plus">{stat.suffix}</span>}
          </span>
          <span class="stats__label">{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* A fixed 4-cell grid (not a dynamic list), so the responsive column
     count and divider placement below are keyed to exact positions rather
     than auto-fit — auto-fit's own border-right-except-:last-child doesn't
     work once the grid wraps to 2 or 1 columns (the border would dangle at
     the end of every row, not just the very last cell). Mobile-first: 1
     column by default, 2 from 560px, the original 4-across from 900px.
     See SiteNav.astro's comment for why 900px is this site's nav/mobile
     breakpoint too. */
  .stats__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .stats__cell {
    /* Kept tight on the sides: the narrower the padding, the more of the
       cell is usable width, which is what lets the equal-width tracks
       above hold COMPLIMENTARY at full size. */
    padding: clamp(20px, 2.2vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stats__cell:nth-child(1),
  .stats__cell:nth-child(2),
  .stats__cell:nth-child(3) {
    border-bottom: 2px solid var(--color-divider);
  }
  .stats__cell:nth-child(4) {
    border-bottom: 0;
  }

  @media (min-width: 560px) {
    .stats__grid {
      /* Second track carries COMPLIMENTARY — see the 900px block below. */
      grid-template-columns: 1fr minmax(min-content, 1fr);
    }
    .stats__cell:nth-child(1) {
      border-right: 2px solid var(--color-divider);
    }
    .stats__cell:nth-child(2) {
      border-right: 0;
    }
    .stats__cell:nth-child(3) {
      border-right: 2px solid var(--color-divider);
      border-bottom: 0;
    }
  }

  @media (min-width: 900px) {
    .stats__grid {
      /* All four tracks are an equal 1fr; the last one just refuses to go
         narrower than the word it holds. On a wide screen COMPLIMENTARY
         fits inside its equal quarter and every block is the same size —
         it only steals width from the others when the screen is too narrow
         for 13 capitals at the full value size. */
      grid-template-columns: repeat(3, 1fr) minmax(min-content, 1fr);
    }
    .stats__cell:nth-child(1),
    .stats__cell:nth-child(2),
    .stats__cell:nth-child(3) {
      border-right: 2px solid var(--color-divider);
      border-bottom: 0;
    }
    .stats__cell:nth-child(4) {
      border-right: 0;
    }
  }

  .stats__value {
    font-family: var(--font-heading);
    font-weight: 900;
    /* Every value shares one size so the four blocks read as a set. The
       ceiling is whatever COMPLIMENTARY — much the longest — can be while
       still fitting an equal quarter-width cell on one line, so the tracks
       never have to go uneven to accommodate it. Full 46px from ~1870px
       up; below that all four step down together. */
    font-size: min(clamp(30px, 3.4vw, 46px), calc(11vw - 4.5px));
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  /* One shared size means one shared line box, so the values sit on a
     common line and their labels do too — no alignment fix needed. The
     ceiling tightens as the grid gains columns and each cell gets less
     room; see the grid breakpoints above. */
  @media (min-width: 560px) {
    .stats__value {
      font-size: min(clamp(30px, 3.4vw, 46px), calc(5.5vw - 4.6px));
    }
  }
  @media (min-width: 900px) {
    .stats__value {
      font-size: min(clamp(30px, 3.4vw, 46px), calc(2.74vw - 5.7px));
    }
  }
  /* COMPLIMENTARY must stay on one line: it is a single word, so it would
     overflow rather than wrap. Tighter tracking than the numbers buys the
     pixels that let it fit an equal-width cell — invisible at this size. */
  .stats__value.is-long {
    letter-spacing: -0.075em;
  }
  .stats__plus {
    color: var(--color-accent);
  }

  .stats__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }
</style>
