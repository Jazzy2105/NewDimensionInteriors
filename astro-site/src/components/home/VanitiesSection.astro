---
// "03 — Vanities & bathrooms" — raised, text-left / image-right (mirrors
// CupboardsSection). Shows a real photo once one exists — see that file.
import { Image } from 'astro:assets';
import { getFeatured } from '../../data/photo-library.js';
import { withBase } from '../../lib/url.js';
import IconArrowRight from '../icons/IconArrowRight.astro';
import PlaceholderPhoto from '../ui/PlaceholderPhoto.astro';

const photo = getFeatured('vanities', 1)[0];
---

<section id="vanities" class="raised-panel split split--mirrored">
  <div class="split__copy">
    <span class="kicker">03 — Vanities &amp; bathrooms</span>
    <h2 class="split__heading">Wet Rooms - Dry Joinery.</h2>
    <p class="split__body">
      No bathroom is complete without a stylish modern vanity unit whether it is a double or single or a
      stand-alone “Tall boy” cabinet, there should be ample storage for all bathroom accessories. NDI prides
      itself on adding the luxuries - Back lit mirrors concealed lighting, stainless trims and basins/mixers.
    </p>
    <a href={withBase('/projects')} class="arrow-link">
      See vanities
      <IconArrowRight />
    </a>
  </div>
  <div class="split__media">
    {
      photo ? (
        <Image src={photo.image} alt={photo.alt} width={1200} format="webp" loading="lazy" class="split__img" />
      ) : (
        <PlaceholderPhoto brief="Drop a vanity / bathroom photo" />
      )
    }
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
  }

  .split--mirrored .split__copy {
    border-left: 0;
    border-right: 2px solid var(--color-divider);
  }

  /* Here the copy comes first in the DOM (text-left/image-right on
     desktop), so once the columns wrap to one, copy sits above the photo —
     a bottom divider on the copy reads correctly, a right one wouldn't. */
  @media (max-width: 679px) {
    .split--mirrored .split__copy {
      border-right: 0;
      border-bottom: 2px solid var(--color-divider);
    }
  }

  .split__media {
    position: relative;
    min-height: min(70vh, 560px);
  }
  .split__media :global(.split__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__copy {
    padding: clamp(32px, 5vw, 80px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .split__heading {
    font-size: clamp(30px, 3.8vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .split__body {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
</style>
