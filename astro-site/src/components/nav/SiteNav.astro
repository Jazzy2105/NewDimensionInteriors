---
// Sticky site header: logo, the four tabs (a hamburger + dropdown below
// ~900px — four fixed-width tabs plus a logo simply don't fit a phone
// screen), and the red panel that slides up on navigation. See "Shared:
// site nav" in ../../../README.md for the full desktop behavior spec this
// was built from.
import { Image } from 'astro:assets';
import logo from '../../assets/images/ndi-logo.png';
import { siteConfig } from '../../data/site-config.js';
import { withBase } from '../../lib/url.js';
import IconMenu from '../icons/IconMenu.astro';
import IconClose from '../icons/IconClose.astro';

interface Props {
  /** Which tab is active for this page. Home only: a scroll listener can
   *  override this to "contact" once the #contact section is in view. */
  active: 'home' | 'about' | 'projects' | '';
}
const { active } = Astro.props;

const tabs = [
  { key: 'home', label: 'Home', href: withBase('/') },
  { key: 'about', label: 'About Us', href: withBase('/about') },
  { key: 'projects', label: 'Projects', href: withBase('/projects') },
  { key: 'contact', label: 'Contact Us', href: withBase('/#contact') },
];
---

<header class="site-nav" data-site-nav data-initial-active={active}>
  <div class="site-nav__row">
    <a href={withBase('/')} class="site-nav__brand" data-nav-link data-nav-label="Home">
      <Image src={logo} alt="N.D.I." height={46} style="height: 46px; width: auto;" />
      <span class="site-nav__brand-label">New Dimension Interiors</span>
    </a>

    <nav class="site-nav__tabs" aria-label="Primary">
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            class={`site-nav__tab ${active === tab.key ? 'is-active' : ''}`}
            data-nav-link
            data-nav-label={tab.label}
            data-tab={tab.key}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>

    <div class="site-nav__actions">
      <button
        type="button"
        class="site-nav__menu-btn"
        data-nav-menu-btn
        aria-expanded="false"
        aria-controls="site-nav-mobile-menu"
        aria-label="Open menu"
      >
        <span class="site-nav__menu-icon site-nav__menu-icon--open">
          <IconMenu size={22} />
        </span>
        <span class="site-nav__menu-icon site-nav__menu-icon--close">
          <IconClose size={20} />
        </span>
      </button>
    </div>
  </div>

  <nav class="site-nav__mobile-menu" id="site-nav-mobile-menu" data-nav-mobile-menu aria-label="Primary, mobile">
    {
      tabs.map((tab) => (
        <a
          href={tab.href}
          class={`site-nav__mobile-link ${active === tab.key ? 'is-active' : ''}`}
          data-nav-link
          data-nav-label={tab.label}
          data-tab={tab.key}
        >
          {tab.label}
        </a>
      ))
    }
  </nav>
</header>

<div class="nav-transition-panel" data-nav-panel>
  <div class="nav-transition-panel__inner" data-nav-panel-inner>
    <span class="nav-transition-panel__bar"></span>
    <span class="nav-transition-panel__label" data-nav-panel-label>{siteConfig.businessName}</span>
  </div>
</div>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(10, 10, 10, 0.86);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 2px solid var(--color-text);
    box-shadow: var(--shadow-nav);
    font-family: var(--font-body);
    color: var(--color-text);
  }

  .site-nav__row {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--section-pad-x);
    height: 76px;
  }

  .site-nav__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none; /* the logo alone is a fixed, known size — never shrink it */
  }

  .site-nav__brand-label {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
    max-width: 11em;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    /* Secondary label, not navigational — dropped once the hamburger takes
       over so the logo and menu button always have room to breathe. */
    .site-nav__brand-label {
      display: none;
    }
  }

  .site-nav__tabs {
    display: flex;
    align-items: stretch;
    margin-left: auto;
  }

  .site-nav__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(112px, 11vw, 160px);
    padding: 0 8px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    border-bottom: 4px solid transparent;
    transition: border-color 200ms ease;
  }
  .site-nav__tab.is-active {
    border-bottom-color: var(--color-accent);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* — mobile menu: hidden above the nav breakpoint, where the full tab row
       fits instead — */
  .site-nav__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    background: transparent;
    border: 2px solid var(--color-neutral-400);
    color: var(--color-text);
    cursor: pointer;
  }
  .site-nav__menu-btn:hover {
    border-color: var(--color-text);
  }

  .site-nav__menu-icon {
    display: none;
  }
  .site-nav__menu-icon--open {
    display: flex;
  }
  .site-nav__menu-btn[aria-expanded='true'] .site-nav__menu-icon--open {
    display: none;
  }
  .site-nav__menu-btn[aria-expanded='true'] .site-nav__menu-icon--close {
    display: flex;
  }

  .site-nav__mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    background: rgba(10, 10, 10, 0.97);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 2px solid var(--color-divider);
    box-shadow: var(--shadow-nav);
  }
  .site-nav__mobile-menu.is-open {
    display: flex;
  }

  .site-nav__mobile-link {
    padding: 18px var(--section-pad-x);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
    border-bottom: 1px solid var(--color-divider);
    border-left: 4px solid transparent;
  }
  .site-nav__mobile-link:last-child {
    border-bottom: 0;
  }
  .site-nav__mobile-link.is-active {
    color: #fff;
    border-left-color: var(--color-accent);
    background: rgba(188, 19, 19, 0.08);
  }

  @media (max-width: 900px) {
    .site-nav__tabs {
      display: none;
    }
    .site-nav__menu-btn {
      display: flex;
    }
  }
  /* Belt-and-suspenders: if the window is resized back above the
     breakpoint while the mobile menu happens to be open, force it closed
     regardless of JS state (the matchMedia listener below also handles
     this, but CSS shouldn't depend on JS having run). */
  @media (min-width: 901px) {
    .site-nav__mobile-menu {
      display: none !important;
    }
  }

  /* the full-viewport red panel that slides up on tab navigation */
  .nav-transition-panel {
    position: fixed;
    inset: 0;
    z-index: 500;
    pointer-events: none;
    background: var(--color-accent);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(24px, 5vw, 72px);
    will-change: transform;
    transform: translateY(101%);
    visibility: hidden;
  }
  .nav-transition-panel.is-armed {
    visibility: visible;
    transition: none;
  }
  .nav-transition-panel.is-active {
    transform: translateY(0);
    transition: transform 260ms cubic-bezier(0.6, 0, 0.2, 1);
  }

  .nav-transition-panel__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: ndiLabelIn 240ms cubic-bezier(0.6, 0, 0.2, 1) both;
  }

  .nav-transition-panel__bar {
    width: 64px;
    height: 5px;
    background: #fff;
  }

  .nav-transition-panel__label {
    font-family: var(--font-heading);
    font-weight: 900;
    color: #fff;
    font-size: clamp(40px, 8vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
</style>

<script>
  // Sticky-nav behavior: (1) a scroll spy that lights the "Contact Us" tab
  // once #contact scrolls near the top of the viewport (Home page only —
  // other pages simply don't have a #contact element, so this is a no-op
  // there); (2) a page-transition panel that slides up over the tab labels
  // before the browser actually navigates, matching the handoff spec;
  // (3) the mobile hamburger menu's open/close state.
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const panelLabel = document.querySelector<HTMLElement>('[data-nav-panel-label]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-nav-menu-btn]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-nav-mobile-menu]');

  if (nav && panel && panelLabel) {
    const tabs = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    const initialActive = nav.dataset.initialActive || '';

    const paint = (activeKey: string) => {
      for (const tab of tabs) {
        tab.classList.toggle('is-active', tab.dataset.tab === activeKey);
      }
    };

    const contactEl = document.getElementById('contact');
    const onScroll = () => {
      if (!contactEl) return;
      const overContact = contactEl.getBoundingClientRect().top <= 160;
      paint(overContact ? 'contact' : initialActive);
    };
    if (contactEl) {
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (menuBtn && mobileMenu) {
      const closeMenu = () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('is-open');
      };
      const toggleMenu = () => {
        const willOpen = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(willOpen));
        mobileMenu.classList.toggle('is-open', willOpen);
      };
      menuBtn.addEventListener('click', toggleMenu);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (!nav.contains(target)) closeMenu();
      });
      // If the window grows past the nav breakpoint while the menu happens
      // to be open, reset the button state to match (CSS already force-hides
      // the panel itself above that width — see the min-width: 901px rule).
      const desktopQuery = window.matchMedia('(min-width: 901px)');
      desktopQuery.addEventListener('change', (event) => {
        if (event.matches) closeMenu();
      });
    }

    let leaving = false;
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    for (const link of links) {
      link.addEventListener('click', (event) => {
        menuBtn?.setAttribute('aria-expanded', 'false');
        mobileMenu?.classList.remove('is-open');

        const href = link.getAttribute('href') || '';
        const hashIndex = href.indexOf('#');

        // Same-page anchor (e.g. clicking "Contact Us" while already on
        // Home): skip the transition panel, smooth-scroll instead.
        if (hashIndex > -1) {
          const targetId = href.slice(hashIndex + 1);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            event.preventDefault();
            window.scrollTo({ top: targetEl.getBoundingClientRect().top + window.scrollY - 74, behavior: 'smooth' });
            return;
          }
        }

        if (leaving) {
          event.preventDefault();
          return;
        }
        event.preventDefault();
        leaving = true;
        panelLabel.textContent = link.dataset.navLabel || '';
        panel.classList.add('is-armed');
        // Force a reflow so the "is-armed" state (panel below the fold, no
        // transition) is committed before we animate it up.
        void panel.offsetHeight;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            panel.classList.add('is-active');
          });
        });
        setTimeout(() => {
          window.location.href = href;
        }, 300);
      });
    }
  }
</script>
