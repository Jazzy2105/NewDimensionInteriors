---
// Switches from a placeholder grid to a real photo grid automatically once
// photos exist in src/assets/images/decor/ — see that folder's README.
import { hasPhotos } from '../../data/photo-library.js';
import PhotoGridPanel from './PhotoGridPanel.astro';
import PlaceholderGridPanel from './PlaceholderGridPanel.astro';

const placeholderTiles = [
  { brief: 'Wall unit / media wall', wide: true },
  { brief: 'Floating shelves' },
  { brief: 'Fireplace or TV surround' },
  { brief: 'Bar or servery' },
  { brief: 'Study desk, full wall', wide: true },
];
const description = 'Wall units, floating shelves, surrounds, bars, desks and headboards.';
---

{
  hasPhotos('decor') ? (
    <PhotoGridPanel category="decor" title="Home decor" description={description} lightboxGroup="projects-decor" />
  ) : (
    <PlaceholderGridPanel category="decor" title="Home decor" description={description} tiles={placeholderTiles} />
  )
}
