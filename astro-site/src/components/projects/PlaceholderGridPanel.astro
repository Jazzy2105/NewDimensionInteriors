---
// Shared renderer for the three categories without real photographs yet
// (cupboards, vanities, decor — see CupboardsGridPanel.astro etc., which
// each just call this with their own tile list). Not used directly by a
// page; kept separate so the three real category files stay tiny and the
// grid/placeholder markup lives in exactly one place.
import PlaceholderPhoto from '../ui/PlaceholderPhoto.astro';

interface Tile {
  brief: string;
  wide?: boolean;
}
interface Props {
  category: string;
  title: string;
  description: string;
  tiles: Tile[];
}
const { category, title, description, tiles } = Astro.props;
---

<section class="raised-panel projects-panel" data-project-category={category}>
  <div class="projects-panel__header">
    <span class="projects-panel__bar"></span>
    <span class="projects-panel__title">{title}</span>
    <span class="projects-panel__description">{description}</span>
  </div>
  <div class="projects-panel__grid">
    {
      tiles.map((tile) => (
        <div class="projects-panel__cell" style={{ gridColumn: tile.wide ? 'span 2' : undefined }}>
          <PlaceholderPhoto brief={tile.brief} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .projects-panel__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding: 22px clamp(16px, 2.4vw, 30px);
    border-bottom: 2px solid var(--color-divider);
  }

  .projects-panel__bar {
    width: 30px;
    height: 4px;
    background: var(--color-accent);
  }

  .projects-panel__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .projects-panel__description {
    font-size: 13px;
    color: var(--color-neutral-600);
  }

  .projects-panel__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    /* See PhotoGridPanel.astro's identical rule — a fixed row height means a
       "wide" cell only ever gets wider, never taller, so it can't leave a
       gap next to shorter neighbours. */
    grid-auto-rows: clamp(200px, 18vw, 320px);
    grid-auto-flow: dense;
    gap: 2px;
    background: var(--color-divider);
  }

  .projects-panel__cell {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-tile-bg);
  }
</style>
