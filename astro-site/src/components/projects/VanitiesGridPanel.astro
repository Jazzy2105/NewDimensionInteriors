---
// Switches from a placeholder grid to a real photo grid automatically once
// photos exist in src/assets/images/vanities/ — see that folder's README.
import { hasPhotos } from '../../data/photo-library.js';
import PhotoGridPanel from './PhotoGridPanel.astro';
import PlaceholderGridPanel from './PlaceholderGridPanel.astro';

const placeholderTiles = [
  { brief: 'Floating vanity — wide shot', wide: true },
  { brief: 'Tall mirror cabinet' },
  { brief: 'Basin and stone top detail' },
  { brief: 'Guest bathroom vanity' },
  { brief: 'Main en-suite, full wall', wide: true },
  { brief: 'Linen cupboard' },
];
const description = 'Moisture-rated boards, sealed edges, stone tops cut to the basin.';
---

{
  hasPhotos('vanities') ? (
    <PhotoGridPanel category="vanities" title="Vanities & bathrooms" description={description} lightboxGroup="projects-vanities" />
  ) : (
    <PlaceholderGridPanel category="vanities" title="Vanities & bathrooms" description={description} tiles={placeholderTiles} />
  )
}
