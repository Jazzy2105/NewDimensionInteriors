---
// The full-bleed red closing CTA that appears near the bottom of every page,
// with page-specific heading copy and sizing.
import { waHref } from '../../data/site-config.js';
import IconMessageSquare from '../icons/IconMessageSquare.astro';

interface Props {
  heading: string;
  buttonLabel?: string;
  withIcon?: boolean;
  /** "home" is the larger, hero-scale treatment; "page" is used on About/Projects. */
  variant?: 'home' | 'page';
}
const { heading, buttonLabel = 'WhatsApp us', withIcon = false, variant = 'page' } = Astro.props;
---

<section class="red-band cta" data-variant={variant}>
  <h2 class="cta__heading">{heading}</h2>
  <a href={waHref()} target="_blank" rel="noopener" class="btn btn-white cta__button">
    {withIcon && <IconMessageSquare size={18} />}
    <span>{buttonLabel}</span>
  </a>
</section>

<style>
  .cta {
    padding: clamp(40px, 7vw, 96px) var(--section-pad-x);
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .cta[data-variant='home'] {
    padding: clamp(48px, 8vw, 120px) var(--section-pad-x);
    gap: 28px;
  }

  .cta__heading {
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 18em;
    font-size: clamp(30px, 5vw, 72px);
  }
  .cta[data-variant='home'] .cta__heading {
    line-height: 0.94;
    max-width: 16em;
    font-size: clamp(34px, 6vw, 88px);
  }

  .cta__button {
    padding: 20px 28px;
  }
</style>
