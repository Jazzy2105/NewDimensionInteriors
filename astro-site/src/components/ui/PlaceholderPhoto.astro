---
// Stands in for a photograph the client hasn't supplied yet (built-in
// cupboards, vanities, home decor — see "Assets" in ../../../README.md: only
// the ten kitchen photos are real). The handoff's `<image-slot>` web
// component was a drag-and-drop tool for the design-authoring environment and
// was explicitly flagged "do not port" — this is its plain, dependency-free
// replacement. `brief` is deliberately shown on the page: it's the shot list
// for whoever ends up photographing the workshop.
import IconImage from '../icons/IconImage.astro';

interface Props {
  brief: string;
}
const { brief } = Astro.props;
---

<div class="placeholder-photo">
  <IconImage size={22} />
  <span>{brief}</span>
</div>

<style>
  .placeholder-photo {
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    background: var(--color-tile-bg);
    border: 2px dashed var(--color-neutral-400);
    color: var(--color-neutral-600);
  }
  .placeholder-photo span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    max-width: 22ch;
  }
</style>
