---
// "Materials & suppliers" — a raised panel reused on Home and Projects with
// slightly different note copy per page.
import { suppliers } from '../../data/suppliers.js';

interface Props {
  note: string;
}
const { note } = Astro.props;
---

<section class="raised-panel suppliers" aria-label="Materials and suppliers">
  <div class="suppliers__header">
    <span class="kicker">Materials &amp; suppliers</span>
    <span class="suppliers__note">{note}</span>
  </div>
  <div class="suppliers__row">
    {suppliers.map((name) => <span class="suppliers__name">{name}</span>)}
  </div>
</section>

<style>
  /* Kicker on its own line with the note spanning the full panel width
     underneath, rather than the two sitting side by side — the note was
     being squeezed into the right-hand third and wrapping over three lines. */
  .suppliers__header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding: 26px clamp(16px, 2.4vw, 32px);
    border-bottom: 2px solid var(--color-divider);
  }

  .suppliers__note {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-neutral-600);
  }

  .suppliers__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px clamp(16px, 2vw, 32px);
    padding: clamp(24px, 3vw, 40px) clamp(16px, 2.4vw, 32px);
  }
  /* `space-between` looks great with one full row of names; once they wrap
     to a ragged last row on a narrow screen it stretches a couple of names
     awkwardly far apart, so switch to a plain left-aligned wrap there. */
  @media (max-width: 639px) {
    .suppliers__row {
      justify-content: flex-start;
    }
  }

  .suppliers__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(15px, 1.5vw, 21px);
    letter-spacing: -0.01em;
    color: var(--color-neutral-700);
    transition: color 200ms ease;
  }
  .suppliers__name:hover {
    color: #fff;
  }
</style>
